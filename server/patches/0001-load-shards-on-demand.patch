+/// Where a usecase's shard databases live.
+///
+/// `resident` keeps every shard in memory (the original behaviour, used by tests).
+/// `onDisk` reads a shard from disk only when a query asks for it, so memory stays flat
+/// however many numbers the database holds.
+enum ShardStore<PirScheme: IndexPirServer>: Sendable {
+    case resident([KeywordPirServer<PirScheme>])
+    case onDisk(ShardCache<PirScheme>)
+
+    func shard(_ index: Int) async throws -> KeywordPirServer<PirScheme> {
+        switch self {
+        case let .resident(shards):
+            guard shards.indices.contains(index) else {
+                throw HTTPError(.badRequest, message: "Shard index \(index) out of range")
+            }
+            return shards[index]
+        case let .onDisk(cache):
+            return try await cache.shard(index)
+        }
+    }
+}
+
+/// Loads shard databases on demand and keeps the most recently used ones in memory.
+actor ShardCache<PirScheme: IndexPirServer> {
+    typealias Scheme = PirScheme.Scheme
+    private let context: Context<Scheme>
+    private let fileStem: String
+    private let parameters: [Apple_SwiftHomomorphicEncryption_Pir_V1_PirParameters]
+    // Each loaded shard of ~7,000 numbers takes about 1.4 MB, so 16 shards cap this at ~22 MB,
+    // small enough for a 256 MB machine. A call needs one shard, and loading one takes milliseconds.
+    private let capacity: Int
+    private var loaded: [Int: KeywordPirServer<PirScheme>] = [:]
+    private var recentlyUsed: [Int] = []
+
+    init(context: Context<Scheme>, fileStem: String,
+         parameters: [Apple_SwiftHomomorphicEncryption_Pir_V1_PirParameters], capacity: Int = 16)
+    {
+        self.context = context
+        self.fileStem = fileStem
+        self.parameters = parameters
+        self.capacity = capacity
+    }
+
+    func shard(_ index: Int) throws -> KeywordPirServer<PirScheme> {
+        guard parameters.indices.contains(index) else {
+            throw HTTPError(.badRequest, message: "Shard index \(index) out of range")
+        }
+        if let shard = loaded[index] {
+            markUsed(index)
+            return shard
+        }
+        let shard = try load(index)
+        loaded[index] = shard
+        markUsed(index)
+        if recentlyUsed.count > capacity {
+            loaded[recentlyUsed.removeFirst()] = nil
+        }
+        return shard
+    }
+
+    private func markUsed(_ index: Int) {
+        recentlyUsed.removeAll { $0 == index }
+        recentlyUsed.append(index)
+    }
+
+    private func load(_ index: Int) throws -> KeywordPirServer<PirScheme> {
+        let pirParams = parameters[index]
+        let database = try ProcessedDatabase(from: "\(fileStem)-\(index).bin", context: context)
+        let processed = try ProcessedDatabaseWithParameters(
+            database: database,
+            algorithm: pirParams.algorithm.native(),
+            evaluationKeyConfig: pirParams.evaluationKeyConfig.native(),
+            pirParameter: pirParams.native(),
+            keywordPirParameter: pirParams.keywordPirParams.nativeWithSymmetricPirClientConfig())
+        return try KeywordPirServer(context: context, processed: processed)
+    }
+}
