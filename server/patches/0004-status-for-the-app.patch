+// Local addition to Apple's example service (Apache-2.0): the status the iPhone app shows.
+import Foundation
+
+/// Incoming calls the server checked, and errors, counted from the metrics log.
+///
+/// iOS asks two questions per unknown caller within a second or two: "block?" and "who is it?".
+/// The test tools ask only "block?". So a cluster of lookups less than 30 seconds apart counts
+/// as one call only if it includes an identity lookup.
+struct CallsChecked {
+    private(set) var last24Hours = 0
+    private(set) var last7Days = 0
+    private(set) var last: Date?
+    private(set) var errors7Days = 0
+
+    init(csv: String, now: Date = .now) {
+        let events = csv.split(separator: "\n").compactMap(Event.init).sorted { $0.time < $1.time }
+        let weekAgo = now.addingTimeInterval(-7 * 86400)
+        errors7Days = events.filter { $0.name == "error" && $0.time > weekAgo }.count
+        var cluster: (start: Date, end: Date, isCall: Bool)?
+        for lookup in events where lookup.name == "lookup" {
+            if let open = cluster, lookup.time.timeIntervalSince(open.end) <= 30 {
+                cluster = (open.start, lookup.time, open.isCall || lookup.asksIdentity)
+            } else {
+                if let closed = cluster { count(closed.start, isCall: closed.isCall, now: now) }
+                cluster = (lookup.time, lookup.time, lookup.asksIdentity)
+            }
+        }
+        if let closed = cluster { count(closed.start, isCall: closed.isCall, now: now) }
+    }
+
+    private mutating func count(_ start: Date, isCall: Bool, now: Date) {
+        guard isCall else { return }
+        last = start
+        if now.timeIntervalSince(start) <= 86400 { last24Hours += 1 }
+        if now.timeIntervalSince(start) <= 7 * 86400 { last7Days += 1 }
+    }
+
+    /// One metrics line: time, event, detail, status, ms. Header lines and blank lines give nil.
+    private struct Event {
+        let time: Date
+        let name: String
+        let asksIdentity: Bool
+
+        init?(_ line: Substring) {
+            let fields = line.split(separator: ",", omittingEmptySubsequences: false)
+            guard fields.count >= 3, let time = try? Date(String(fields[0]), strategy: .iso8601) else { return nil }
+            self.time = time
+            name = String(fields[1])
+            asksIdentity = fields[2].split(separator: "+").contains("identity")
+        }
+    }
+}
+
+extension MetricsLog {
+    /// The JSON the app fetches: server start, calls checked and errors, plus the notes the Mac
+    /// uploads (database and Ofcom check) and the Mac's phone call report, unchanged.
+    func status() -> Data {
+        let calls = CallsChecked(csv: allLines())
+        let object: [String: Any] = [
+            "server": ["started": startedAt.formatted(.iso8601), "now": Date.now.formatted(.iso8601)],
+            "calls_checked": [
+                "last_24h": calls.last24Hours,
+                "last_7d": calls.last7Days,
+                "last": calls.last.map { $0.formatted(.iso8601) as Any } ?? NSNull(),
+            ],
+            "errors_7d": calls.errors7Days,
+            "mac": document(.macNotes).flatMap { try? JSONSerialization.jsonObject(with: $0) } ?? NSNull(),
+            "phone": document(.phoneSummary).flatMap { try? JSONSerialization.jsonObject(with: $0) } ?? NSNull(),
+        ]
+        return (try? JSONSerialization.data(withJSONObject: object, options: [.sortedKeys])) ?? Data("{}".utf8)
+    }
+}
