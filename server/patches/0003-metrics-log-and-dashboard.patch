diff --git a/Sources/PIRService/Controllers/DashboardController.swift b/Sources/PIRService/Controllers/DashboardController.swift
new file mode 100644
index 0000000..1e649a3
--- /dev/null
+++ b/Sources/PIRService/Controllers/DashboardController.swift
@@ -0,0 +1,82 @@
+// Local addition to Apple's example service (Apache-2.0): a password-protected metrics dashboard.
+import Foundation
+import Hummingbird
+import NIOCore
+
+/// Serves the dashboard page, the server's metrics CSV, and the phone summary that the Mac
+/// report uploads (counts only, never numbers). Every route needs HTTP Basic authentication
+/// with the dashboard password; the user name is ignored.
+struct DashboardController {
+    let metrics: MetricsLog
+    let password: String
+    let page: URL
+
+    func addRoutes(to group: RouterGroup<AppContext>) {
+        group
+            .get(use: page)
+            .get("server.csv", use: serverCSV)
+            .get("phone.json", use: phoneSummary)
+            .post("phone.json", use: storePhoneSummary)
+    }
+
+    func page(_ request: Request, context _: AppContext) async throws -> Response {
+        try authorize(request)
+        let html = try Data(contentsOf: page)
+        return respond(html, type: "text/html; charset=utf-8")
+    }
+
+    func serverCSV(_ request: Request, context _: AppContext) async throws -> Response {
+        try authorize(request)
+        return await respond(Data(metrics.allLines().utf8), type: "text/csv; charset=utf-8")
+    }
+
+    func phoneSummary(_ request: Request, context _: AppContext) async throws -> Response {
+        try authorize(request)
+        guard let summary = await metrics.phoneSummary() else {
+            throw HTTPError(.notFound, message: "No phone summary uploaded yet.")
+        }
+        return respond(summary, type: "application/json")
+    }
+
+    func storePhoneSummary(_ request: Request, context _: AppContext) async throws -> Response {
+        try authorize(request)
+        let body = Data(try await request.body.collect(upTo: 256 * 1024).readableBytesView)
+        guard (try? JSONSerialization.jsonObject(with: body)) is [String: Any] else {
+            throw HTTPError(.badRequest, message: "Expected a JSON object.")
+        }
+        try await metrics.store(phoneSummary: body)
+        return Response(status: .noContent)
+    }
+
+    private func authorize(_ request: Request) throws {
+        let unauthorized = HTTPError(
+            .unauthorized,
+            headers: [.wwwAuthenticate: "Basic realm=\"ScamBlocker dashboard\", charset=\"UTF-8\""])
+        guard let header = request.headers[.authorization], header.hasPrefix("Basic "),
+              let decoded = Data(base64Encoded: String(header.dropFirst(6))),
+              let credentials = String(data: decoded, encoding: .utf8),
+              let colon = credentials.firstIndex(of: ":")
+        else { throw unauthorized }
+        let given = Array(credentials[credentials.index(after: colon)...].utf8)
+        let expected = Array(password.utf8)
+        // Compare every byte so the time taken doesn't reveal how much of the password matched.
+        var difference = given.count ^ expected.count
+        for index in 0..<min(given.count, expected.count) {
+            difference |= Int(given[index] ^ expected[index])
+        }
+        guard difference == 0 else { throw unauthorized }
+    }
+
+    private func respond(_ data: Data, type: String) -> Response {
+        Response(
+            status: .ok,
+            headers: [
+                .contentType: type,
+                .cacheControl: "no-store",
+                .init("X-Content-Type-Options")!: "nosniff",
+                .init("Content-Security-Policy")!:
+                    "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'",
+            ],
+            body: .init(byteBuffer: ByteBuffer(bytes: data)))
+    }
+}
diff --git a/Sources/PIRService/Controllers/MetricsLog.swift b/Sources/PIRService/Controllers/MetricsLog.swift
new file mode 100644
index 0000000..5084258
--- /dev/null
+++ b/Sources/PIRService/Controllers/MetricsLog.swift
@@ -0,0 +1,105 @@
+// Local addition to Apple's example service (Apache-2.0): request metrics for the dashboard.
+import Foundation
+import Hummingbird
+
+/// Appends one CSV line per lookup, key upload, error and server start to a monthly file,
+/// and keeps the phone summary the Mac report uploads. The server never sees caller numbers,
+/// so none can be written here. Columns: time (UTC), event, detail, status, ms.
+actor MetricsLog {
+    static let header = "time,event,detail,status,ms"
+    private let directory: URL
+    private var phoneSummaryFile: URL { directory.appendingPathComponent("phone-summary.json") }
+
+    init(directory: URL) throws {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        self.directory = directory
+    }
+
+    func record(_ event: String, detail: String = "", status: String = "", ms: Int? = nil) {
+        let now = Date.now
+        let line = [now.formatted(.iso8601), event, detail, status, ms.map(String.init) ?? ""]
+            .joined(separator: ",") + "\n"
+        let file = directory.appendingPathComponent("server-\(Self.month(of: now)).csv")
+        guard FileManager.default.fileExists(atPath: file.path) else {
+            FileManager.default.createFile(atPath: file.path, contents: Data((Self.header + "\n" + line).utf8))
+            return
+        }
+        guard let handle = try? FileHandle(forWritingTo: file) else { return }
+        defer { try? handle.close() }
+        _ = try? handle.seekToEnd()
+        try? handle.write(contentsOf: Data(line.utf8))
+    }
+
+    /// Every monthly file joined into one CSV with a single header.
+    func allLines() -> String {
+        let names = (try? FileManager.default.contentsOfDirectory(atPath: directory.path)) ?? []
+        var csv = Self.header + "\n"
+        for name in names.filter({ $0.hasPrefix("server-") && $0.hasSuffix(".csv") }).sorted() {
+            guard let text = try? String(contentsOf: directory.appendingPathComponent(name), encoding: .utf8) else {
+                continue
+            }
+            csv += text.split(separator: "\n").dropFirst().map { $0 + "\n" }.joined()
+        }
+        return csv
+    }
+
+    func phoneSummary() -> Data? {
+        try? Data(contentsOf: phoneSummaryFile)
+    }
+
+    func store(phoneSummary: Data) throws {
+        try phoneSummary.write(to: phoneSummaryFile, options: .atomic)
+    }
+
+    private static func month(of date: Date) -> String {
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = TimeZone(identifier: "UTC")!
+        let parts = calendar.dateComponents([.year, .month], from: date)
+        return String(format: "%04d-%02d", parts.year ?? 0, parts.month ?? 0)
+    }
+}
+
+/// The endpoints the phone uses; requests to anything else are not recorded.
+let phoneEndpointPaths: Set<String> = [
+    "/queries", "/key", "/config", "/issue", "/token-key-for-user-token",
+    "/.well-known/private-token-issuer-directory",
+]
+
+/// Records failed requests and phone key uploads on the endpoints the phone uses. Successful
+/// lookups are recorded by the lookup handler, which knows which dataset was asked. Anything else,
+/// such as scanners probing random paths on the public address, is ignored.
+struct MetricsMiddleware<Context: RequestContext>: RouterMiddleware {
+    let metrics: MetricsLog
+
+    func handle(
+        _ request: Request,
+        context: Context,
+        next: (Request, Context) async throws -> Response) async throws -> Response
+    {
+        let path = request.uri.path
+        guard phoneEndpointPaths.contains(path) else { return try await next(request, context) }
+        let started = ContinuousClock.now
+        let route = "\(request.method.rawValue) \(path)"
+        do {
+            let response = try await next(request, context)
+            let code = response.status.code
+            if code >= 400 {
+                await metrics.record("error", detail: route, status: "\(code)", ms: started.millisecondsSince)
+            } else if route == "POST /key" {
+                await metrics.record("key", status: "\(code)", ms: started.millisecondsSince)
+            }
+            return response
+        } catch {
+            let code = (error as? any HTTPResponseError)?.status.code ?? 500
+            await metrics.record("error", detail: route, status: "\(code)", ms: started.millisecondsSince)
+            throw error
+        }
+    }
+}
+
+extension ContinuousClock.Instant {
+    var millisecondsSince: Int {
+        let elapsed = duration(to: .now).components
+        return Int(elapsed.seconds * 1000 + elapsed.attoseconds / 1_000_000_000_000_000)
+    }
+}
