+// Copyright 2026 bencium. Local addition to Apple's example service (Apache-2.0).
+import Crypto
+import Foundation
+import Hummingbird
+import ServiceLifecycle
+
+/// Stores each value as a file, so the evaluation keys phones upload survive a restart.
+///
+/// The example service keeps them in memory; after a restart every phone's next lookup fails
+/// until iOS notices and uploads its key again. File names are SHA-256 hashes of the keys.
+struct FilePersistDriver: PersistDriver {
+    private let directory: URL
+
+    init(directory: URL) throws {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        self.directory = directory
+    }
+
+    func run() async throws {
+        try? await gracefulShutdown()
+    }
+
+    func create<Object: Codable & Sendable>(key: String, value: Object, expires: Duration?) async throws {
+        guard !FileManager.default.fileExists(atPath: path(for: key).path) else { throw PersistError.duplicate }
+        try await set(key: key, value: value, expires: expires)
+    }
+
+    func set<Object: Codable & Sendable>(key: String, value: Object, expires: Duration?) async throws {
+        let expiry = expires.map { Date.now.addingTimeInterval(TimeInterval($0.components.seconds)) }
+        try JSONEncoder().encode(Entry(expires: expiry, value: value)).write(to: path(for: key), options: .atomic)
+    }
+
+    func get<Object: Codable & Sendable>(key: String, as _: Object.Type) async throws -> Object? {
+        guard let data = try? Data(contentsOf: path(for: key)) else { return nil }
+        let entry = try JSONDecoder().decode(Entry<Object>.self, from: data)
+        if let expires = entry.expires, expires < .now {
+            try await remove(key: key)
+            return nil
+        }
+        return entry.value
+    }
+
+    func remove(key: String) async throws {
+        try? FileManager.default.removeItem(at: path(for: key))
+    }
+
+    private func path(for key: String) -> URL {
+        let name = SHA256.hash(data: Data(key.utf8)).map { String(format: "%02x", $0) }.joined()
+        return directory.appendingPathComponent(name)
+    }
+
+    private struct Entry<Object: Codable>: Codable {
+        let expires: Date?
+        let value: Object
+    }
+}
